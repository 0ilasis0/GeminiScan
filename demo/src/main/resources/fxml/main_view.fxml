<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.2" maxWidth="Infinity" maxHeight="Infinity"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.ui.MainController">

    <VBox spacing="15.0" minWidth="200.0">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>

        <Label text="專案設定" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <Button fx:id="btnSelectFolder" text="選擇掃描資料夾" maxWidth="Infinity" />
        <Label fx:id="lblProjectPath" text="尚未選擇資料夾..." wrapText="true" textFill="gray" />

        <Separator />

        <Label text="引擎參數" style="-fx-font-size: 14px; -fx-font-weight: bold;" />

        <Label text="比對演算法：" />
        <ComboBox fx:id="comboAlgorithm" maxWidth="Infinity" />

        <Label text="重複執行策略：" />
        <ComboBox fx:id="comboStrategy" maxWidth="Infinity" />

        <Label text="相似度容忍閥值 (0~20)：" />
        <Spinner fx:id="spinnerThreshold" maxWidth="Infinity" />

        <Label text="使用 CPU 核心數：" />
        <Spinner fx:id="spinnerThreads" maxWidth="Infinity" />

        <Region VBox.vgrow="ALWAYS" />

        <VBox spacing="10.0">
            <Label fx:id="lblStatus" text="準備就緒" />
            <ProgressBar fx:id="progressBar" progress="0.0" maxWidth="Infinity" />

            <HBox spacing="10.0">
                <Button fx:id="btnStart" text="▶ 開始掃描" style="-fx-base: #4CAF50;" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnCancel" text="⏹ 取消" disable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </VBox>


    <SplitPane dividerPositions="0.8" orientation="VERTICAL">
        <BorderPane>
            <top>
                <HBox spacing="15.0" alignment="CENTER_LEFT" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                    <Label fx:id="lblResultSummary" text="掃描結果：等待執行..." style="-fx-font-size: 16px; -fx-font-weight: bold;" />

                    <Region HBox.hgrow="ALWAYS" /> <Button fx:id="btnSmartSelect" text="✨ 智慧保留最佳畫質" disable="true" />
                    <Button fx:id="btnDeleteSelected" text="🗑️ 將勾選項目移至回收桶" style="-fx-base: #f44336;" disable="true" />
                </HBox>
            </top>

            <center>
                <ListView fx:id="resultListView" BorderPane.alignment="CENTER" />
            </center>
        </BorderPane>

        <VBox spacing="5.0" minHeight="100.0" minWidth="500.0" style="-fx-background-color: #2b2b2b;">
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="💻 系統日誌 (Terminal)" textFill="WHITE" style="-fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="清除日誌" onAction="#handleClearLogs" style="-fx-font-size: 10px;" />
            </HBox>
            <TextArea fx:id="txtConsole" editable="false" wrapText="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-control-inner-background: #1e1e1e; -fx-font-family: 'Consolas', 'Monospaced'; -fx-text-fill: #dcdcdc;" />
        </VBox>
    </SplitPane>

</SplitPane>